
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tech Baby Studios - Mobile Director Suite</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 0; overflow-x: hidden; }
        .glass-panel { background: rgba(30, 41, 59, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }
        #canvas3d { width: 100%; height: 100%; display: block; }
    </style>
</head>
<body class="h-screen w-screen flex flex-col overflow-hidden select-none">

    <!-- HEADER BAR -->
    <header class="h-12 glass-panel border-b border-slate-700/50 px-3 flex items-center justify-between shrink-0 z-30">
        <div class="flex items-center space-x-2">
            <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center font-black text-sm text-white">TB</div>
            <span class="text-xs font-bold text-blue-400">Tech Baby Studios</span>
        </div>
        <div class="flex items-center space-x-2">
            <button id="btnRecordCanvas" class="bg-red-600 hover:bg-red-500 text-white px-3 py-1 rounded text-xs font-bold shadow">
                <i class="fa-solid fa-circle text-[8px] mr-1"></i> Record
            </button>
            <button id="btnSaveStorage" class="bg-slate-800 text-slate-200 px-2 py-1 rounded text-xs">
                <i class="fa-solid fa-floppy-disk text-blue-400"></i> Save
            </button>
        </div>
    </header>

    <!-- 3D VIEWPORT CANVAS (Top Half on Mobile) -->
    <div id="viewportContainer" class="h-1/2 w-full relative bg-slate-950 overflow-hidden shrink-0">
        <canvas id="canvas3d"></canvas>
        <div class="absolute top-2 left-2 bg-slate-900/80 px-2 py-1 rounded text-[10px] text-cyan-400 border border-slate-700">
            <i class="fa-solid fa-video mr-1"></i> Live 3D Stage
        </div>
    </div>

    <!-- CONTROL PANEL (Bottom Half on Mobile) -->
    <main class="flex-1 glass-panel flex flex-col border-t border-slate-700/60 overflow-hidden z-20">
        <!-- Tab Bar -->
        <div class="flex border-b border-slate-700/60 bg-slate-900/60 shrink-0">
            <button onclick="switchTab('customizer')" class="flex-1 py-2 text-xs font-bold text-blue-400 border-b-2 border-blue-500">Customizer</button>
            <button onclick="switchTab('director')" class="flex-1 py-2 text-xs font-bold text-slate-400 border-b-2 border-transparent">AI Director</button>
            <button onclick="switchTab('files')" class="flex-1 py-2 text-xs font-bold text-slate-400 border-b-2 border-transparent">Storage</button>
        </div>

        <!-- Scrollable Tab Content Area -->
        <div class="flex-1 overflow-y-auto p-3 space-y-4">
            
            <!-- 1. CUSTOMIZER TAB -->
            <div id="tab-customizer" class="space-y-3">
                <div class="bg-slate-800/80 rounded-lg p-3 space-y-2 border border-slate-700">
                    <span class="text-xs font-bold text-cyan-300"><i class="fa-solid fa-baby mr-1"></i> Boss Baby Helmet</span>
                    <select id="selectBabyHelmet" onchange="updateCustomizer()" class="w-full bg-slate-900 border border-slate-700 rounded p-1.5 text-xs text-slate-200">
                        <option value="oversized">Oversized Genius Helmet</option>
                        <option value="visor">Tactical Glowing Visor</option>
                        <option value="bare">Bare Head / No Helmet</option>
                    </select>
                </div>

                <div class="bg-slate-800/80 rounded-lg p-3 space-y-2 border border-slate-700">
                    <span class="text-xs font-bold text-cyan-300"><i class="fa-solid fa-robot mr-1"></i> AI Drone Face Expression</span>
                    <div class="grid grid-cols-3 gap-1.5">
                        <button onclick="setDroneFace('happy')" class="bg-slate-900 border border-cyan-500/40 text-cyan-400 py-1.5 rounded text-xs font-mono font-bold">^ _ ^</button>
                        <button onclick="setDroneFace('shocked')" class="bg-slate-900 border border-slate-700 text-slate-300 py-1.5 rounded text-xs font-mono font-bold">O _ O</button>
                        <button onclick="setDroneFace('dizzy')" class="bg-slate-900 border border-slate-700 text-slate-300 py-1.5 rounded text-xs font-mono font-bold">@ _ @</button>
                        <button onclick="setDroneFace('alert')" class="bg-slate-900 border border-slate-700 text-slate-300 py-1.5 rounded text-xs font-mono font-bold">! _ !</button>
                        <button onclick="setDroneFace('sleep')" class="bg-slate-900 border border-slate-700 text-slate-300 py-1.5 rounded text-xs font-mono font-bold">u _ u</button>
                        <button onclick="setDroneFace('angry')" class="bg-slate-900 border border-slate-700 text-slate-300 py-1.5 rounded text-xs font-mono font-bold">&gt; _ &lt;</button>
                    </div>
                </div>
            </div>

            <!-- 2. AI DIRECTOR PROMPT TAB -->
            <div id="tab-director" class="hidden space-y-3">
                <div class="bg-slate-800/80 rounded-lg p-3 space-y-2 border border-slate-700">
                    <label class="text-xs font-bold text-amber-300"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i> AI Director Command</label>
                    <textarea id="txtPrompt" rows="3" class="w-full bg-slate-900 border border-slate-700 rounded p-2 text-xs text-slate-200 outline-none" placeholder="Type scene direction... e.g. 'Boss Baby plugs in core and panics'"></textarea>
                    <button onclick="runAiDirector()" class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 text-white py-2 rounded text-xs font-bold shadow">Execute Prompt</button>
                </div>
                
                <div class="bg-slate-800/60 rounded-lg p-2 border border-slate-700 text-[11px] text-slate-400 space-y-1">
                    <span class="font-bold text-slate-300">Quick Prompt Ideas:</span>
                    <p onclick="applyQuickPrompt(this)" class="cursor-pointer hover:text-cyan-300">⚡ "Boss Baby plugs in core and sparks fly"</p>
                    <p onclick="applyQuickPrompt(this)" class="cursor-pointer hover:text-cyan-300">🤖 "Drone panics with wide eyes"</p>
                    <p onclick="applyQuickPrompt(this)" class="cursor-pointer hover:text-cyan-300">💥 "House blackout explosion"</p>
                </div>
            </div>

            <!-- 3. STORAGE & FILE BACKUP TAB -->
            <div id="tab-files" class="hidden space-y-3">
                <div class="bg-slate-800/80 rounded-lg p-3 space-y-2 border border-slate-700">
                    <span class="text-xs font-bold text-emerald-300"><i class="fa-solid fa-shield-halved mr-1"></i> Phone File Backup</span>
                    <p class="text-[11px] text-slate-400">Save designs straight to your phone's Download folder before clearing browser history.</p>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="downloadProfile()" class="bg-emerald-600 text-white text-xs py-1.5 rounded font-bold">Download Profile</button>
                        <label class="bg-slate-700 text-slate-200 text-xs py-1.5 rounded font-bold text-center cursor-pointer">
                            Import File
                            <input type="file" id="fileImportProfile" onchange="importProfile(event)" accept=".json" class="hidden">
                        </label>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- THREE.JS 3D INITIALIZATION ENGINE -->
    <script>
        let scene, camera, renderer, babyGroup, droneGroup, helmetMesh;

        function init3D() {
            const container = document.getElementById('viewportContainer');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0f1d);

            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(0, 1.5, 5);

            renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('canvas3d'), antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);
            const dirLight = new THREE.DirectionalLight(0x38bdf8, 1.2);
            dirLight.position.set(5, 10, 7);
            scene.add(dirLight);

            // Grid Floor
            const grid = new THREE.GridHelper(20, 20, 0x3b82f6, 0x1e293b);
            grid.position.y = -0.5;
            scene.add(grid);

            // Boss Baby 3D Representation
            babyGroup = new THREE.Group();
            
            // Head / Face
            const headGeo = new THREE.SphereGeometry(0.4, 32, 32);
            const headMat = new THREE.MeshStandardMaterial({ color: 0xffdbac });
            const head = new THREE.Mesh(headGeo, headMat);
            head.position.y = 0.5;
            babyGroup.add(head);

            // Oversized Helmet
            const helmetGeo = new THREE.SphereGeometry(0.52, 32, 32);
            const helmetMat = new THREE.MeshStandardMaterial({ color: 0x3b82f6, metalness: 0.5, roughness: 0.2 });
            helmetMesh = new THREE.Mesh(helmetGeo, helmetMat);
            helmetMesh.position.y = 0.55;
            babyGroup.add(helmetMesh);

            // Lab Coat Body
            const bodyGeo = new THREE.CylinderGeometry(0.25, 0.35, 0.7, 32);
            const bodyMat = new THREE.MeshStandardMaterial({ color: 0xffffff });
            const body = new THREE.Mesh(bodyGeo, bodyMat);
            body.position.y = -0.1;
            babyGroup.add(body);

            babyGroup.position.set(-0.8, 0, 0);
            scene.add(babyGroup);

            // AI Drone 3D Representation
            droneGroup = new THREE.Group();
            const droneGeo = new THREE.SphereGeometry(0.35, 32, 32);
            const droneMat = new THREE.MeshStandardMaterial({ color: 0x06b6d4, metalness: 0.8, roughness: 0.2 });
            const droneBody = new THREE.Mesh(droneGeo, droneMat);
            droneGroup.add(droneBody);

            droneGroup.position.set(0.8, 0.8, 0);
            scene.add(droneGroup);

            // Handle Resize
            window.addEventListener('resize', onWindowResize);
            animate();
        }

        function animate() {
            requestAnimationFrame(animate);
            if (droneGroup) {
                droneGroup.position.y = 0.8 + Math.sin(Date.now() * 0.003) * 0.08;
            }
            renderer.render(scene, camera);
        }

        function onWindowResize() {
            const container = document.getElementById('viewportContainer');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        function switchTab(tabName) {
            document.querySelectorAll('[id^="tab-"]').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabName).classList.remove('hidden');
        }

        function updateCustomizer() {
            const val = document.getElementById('selectBabyHelmet').value;
            if (val === 'bare') helmetMesh.visible = false;
            else {
                helmetMesh.visible = true;
                helmetMesh.material.color.setHex(val === 'visor' ? 0x06b6d4 : 0x3b82f6);
            }
        }

        function setDroneFace(type) {
            if (droneGroup) {
                droneGroup.rotation.y += 0.5;
            }
        }

        function runAiDirector() {
            const prompt = document.getElementById('txtPrompt').value.toLowerCase();
            if (prompt.includes('plug') || prompt.includes('spark')) {
                camera.position.set(0, 1, 3);
                droneGroup.rotation.z += 0.4;
            } else if (prompt.includes('panic') || prompt.includes('eyes')) {
                camera.position.set(0.8, 0.8, 2);
            } else {
                camera.position.set(0, 1.5, 5);
            }
        }

        function applyQuickPrompt(el) {
            document.getElementById('txtPrompt').value = el.innerText.replace(/^[^\s]+\s/, '');
            switchTab('director');
            runAiDirector();
        }

        function downloadProfile() {
            const data = JSON.stringify({ helmet: document.getElementById('selectBabyHelmet').value, date: new Date() });
            const blob = new Blob([data], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'TechBaby_Profile.json';
            a.click();
        }

        function importProfile(e) {
            const file = e.target.files[0];
            if (file) alert('Profile loaded successfully from phone storage!');
        }

        window.onload = init3D;
    </script>
</body>
</
